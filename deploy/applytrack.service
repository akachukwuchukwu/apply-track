[Unit]
Description=Apply Track (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/applytrack
EnvironmentFile=/etc/applytrack.env
ExecStart=/opt/applytrack/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8001 --workers 2 --no-control-socket --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=3

# Light sandboxing: the service can't gain privileges, gets a private /tmp, and
# can only write to its own data directory (plus /tmp), not to the code or system.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/applytrack

[Install]
WantedBy=multi-user.target
