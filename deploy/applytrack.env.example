# Environment for the Apply Track service. DEPLOYMENT.md installs this as
# /etc/applytrack.env (owner root, group www-data, mode 640) and fills in the
# two placeholders. systemd reads it as plain KEY=value lines: no quotes, and no
# spaces around the "=".
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=__SECRET_KEY__
DJANGO_ALLOWED_HOSTS=__HOST__
DJANGO_CSRF_TRUSTED_ORIGINS=https://__HOST__

# gunicorn is only reachable through the Apache proxy on this machine, so it is
# safe to trust the proxy's X-Forwarded-* headers, and there is exactly one proxy.
DJANGO_BEHIND_PROXY=True
DJANGO_NUM_PROXIES=1

# Data lives outside the code directory, so updating the code can never touch it.
DJANGO_DB_PATH=/var/lib/applytrack/db.sqlite3
DJANGO_CACHE_DIR=/var/lib/applytrack/cache
